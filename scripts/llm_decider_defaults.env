#!/bin/bash

# Repo-level defaults for the embedded LLM decision engine.
# External environment variables still win because every assignment uses ${VAR:-...}.

export TRAINING_LLM_DECIDER_ENABLED="${TRAINING_LLM_DECIDER_ENABLED:-1}"
export TRAINING_LLM_DECIDER_MODE="${TRAINING_LLM_DECIDER_MODE:-live}"

# Decider architecture: "llambo" = LR-only lean decider (default, Phase 3),
# "legacy" = full 15-field decider with pacing/clamp guardrails (rollback).
export TRAINING_DECIDER_MODE="${TRAINING_DECIDER_MODE:-llambo}"

# Phase 4: GP-based Bayesian Optimization fallback in suggest_next_lr().
# When LLM fails (network/parse/invalid), fit GP on past observations and
# suggest LR via Expected Improvement. Requires >= TRAINING_BO_MIN_OBSERVATIONS.
export TRAINING_BO_AUGMENT="${TRAINING_BO_AUGMENT:-true}"
export TRAINING_BO_MIN_OBSERVATIONS="${TRAINING_BO_MIN_OBSERVATIONS:-3}"
export TRAINING_BO_SEED="${TRAINING_BO_SEED:-42}"
# GRPO included (2026-04-21): LLM Decision Engine still skipped for GRPO
# (orchestrator sets mode="finish"), but vLLM sidecar needs to start so the
# new LLM Warmstart tier (see llm_warmstart.py) can query it for LR suggestion.
# NCCL SHM pressure is already mitigated via NCCL_SHM_DISABLE=1 in entrypoint.sh.
export TRAINING_LLM_DECIDER_TASK_TYPES="${TRAINING_LLM_DECIDER_TASK_TYPES:-InstructTextTask,DpoTask,ChatTask,GrpoTask}"

export TRAINING_LLM_SERVER_EMBEDDED="${TRAINING_LLM_SERVER_EMBEDDED:-1}"
export TRAINING_LLM_SERVER_MODEL="${TRAINING_LLM_SERVER_MODEL:-/opt/models/llm_decider}"
export TRAINING_LLM_DECIDER_MODEL="${TRAINING_LLM_DECIDER_MODEL:-$TRAINING_LLM_SERVER_MODEL}"
export TRAINING_LLM_SERVER_TRUST_REMOTE_CODE="${TRAINING_LLM_SERVER_TRUST_REMOTE_CODE:-0}"
export TRAINING_LLM_SERVER_QUANTIZATION="${TRAINING_LLM_SERVER_QUANTIZATION:-awq}"

export TRAINING_LLM_SERVER_HOST="${TRAINING_LLM_SERVER_HOST:-127.0.0.1}"
export TRAINING_LLM_SERVER_PORT="${TRAINING_LLM_SERVER_PORT:-8000}"
export TRAINING_LLM_SERVER_GPU_MEMORY_UTILIZATION="${TRAINING_LLM_SERVER_GPU_MEMORY_UTILIZATION:-0.22}"
export TRAINING_LLM_SERVER_MAX_MODEL_LEN="${TRAINING_LLM_SERVER_MAX_MODEL_LEN:-8192}"
export TRAINING_LLM_SERVER_USE_V1="${TRAINING_LLM_SERVER_USE_V1:-0}"

export TRAINING_LLM_DECIDER_TIMEOUT_SECONDS="${TRAINING_LLM_DECIDER_TIMEOUT_SECONDS:-45}"
export TRAINING_LLM_DECIDER_MIN_CONFIDENCE="${TRAINING_LLM_DECIDER_MIN_CONFIDENCE:-0.35}"
export TRAINING_LLM_DECIDER_MIN_RUNS_FOR_FINISH="${TRAINING_LLM_DECIDER_MIN_RUNS_FOR_FINISH:-2}"
export TRAINING_LLM_DECIDER_MIN_LR_MULTIPLIER="${TRAINING_LLM_DECIDER_MIN_LR_MULTIPLIER:-0.45}"
export TRAINING_LLM_DECIDER_MAX_LR_MULTIPLIER="${TRAINING_LLM_DECIDER_MAX_LR_MULTIPLIER:-1.55}"
export TRAINING_LLM_DECIDER_MAX_TOKENS="${TRAINING_LLM_DECIDER_MAX_TOKENS:-350}"
export TRAINING_LLM_DECIDER_MAX_CONTEXT_RUNS="${TRAINING_LLM_DECIDER_MAX_CONTEXT_RUNS:-20}"

export TRAINING_LR_FINDER_ENABLE_LANDSCAPE="${TRAINING_LR_FINDER_ENABLE_LANDSCAPE:-1}"
export TRAINING_LR_FINDER_MIN_FREE_GB_FOR_LANDSCAPE="${TRAINING_LR_FINDER_MIN_FREE_GB_FOR_LANDSCAPE:-3.0}"
export TRAINING_LR_FINDER_TIME_BUDGET_MINUTES="${TRAINING_LR_FINDER_TIME_BUDGET_MINUTES:-15.0}"
export TRAINING_LR_FINDER_PROBE_STEPS="${TRAINING_LR_FINDER_PROBE_STEPS:-2}"
export TRAINING_LR_FINDER_STEP_TIME_MULTIPLIER="${TRAINING_LR_FINDER_STEP_TIME_MULTIPLIER:-3.4}"
