# Template for local baseline run. Copy to .env and fill.
# .env is gitignored — safe to put tokens here.

export TASK_ID="replace-with-task-uuid"
export MODEL="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
export DATASET="https://s3.example/train_data.json?sig=..."
export FILE_FORMAT="s3"
export HOURS_TO_COMPLETE=6

export DATASET_TYPE='{"field_system": null, "field_instruction": "instruct", "field_input": null, "field_output": "output", "format": null, "no_input_format": null, "system_format": null}'

export TEST_DATA_URL=""  # optional: validator test set (post-tournament) for local eval harness

export HUGGINGFACE_TOKEN="hf_xxx"
export HUGGINGFACE_USERNAME="your-hf-username"
export EXPECTED_REPO_NAME="text-jagger-baseline"
export WANDB_TOKEN=""
